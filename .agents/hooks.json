{
  "universal-modder-env": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'if [ -d \"$PWD/bin\" ]; then export PATH=\"$PWD/bin:$PATH\"; fi'"
          }
        ]
      }
    ]
  }
}
